{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "triggers": {
    "kpp_mining_start": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 4000,
              "minLength": 1,
              "title": "Question",
              "type": "string"
            },
            "run_id": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          "required": [
            "question"
          ],
          "title": "DemoRequest",
          "type": "object"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    }
  },
  "actions": {
    "Validate_request": {
      "type": "ParseJson",
      "runAfter": {},
      "inputs": {
        "content": "@triggerBody()",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 4000,
              "minLength": 1,
              "title": "Question",
              "type": "string"
            },
            "run_id": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          "required": [
            "question"
          ],
          "title": "DemoRequest",
          "type": "object"
        }
      }
    },
    "Reject_invalid_request": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {
        "Validate_request": [
          "Failed",
          "TimedOut"
        ]
      },
      "inputs": {
        "statusCode": 400,
        "body": {
          "error": {
            "code": "invalid_request",
            "message": "Supply a question and optional run_id only; route overrides are rejected."
          }
        }
      }
    },
    "capture_question": {
      "type": "Compose",
      "runAfter": {
        "Validate_request": [
          "Succeeded"
        ]
      },
      "inputs": {
        "question": "@triggerBody()?['question']",
        "run_id": "@coalesce(triggerBody()?['run_id'],guid())"
      }
    },
    "Initialize_result": {
      "type": "InitializeVariable",
      "runAfter": {
        "capture_question": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "NativeResponses",
            "type": "string",
            "value": ""
          },
          {
            "name": "Result",
            "type": "object",
            "value": {
              "run_id": "@outputs('capture_question')?['run_id']",
              "route": "unsupported",
              "status": "failed",
              "answer": null,
              "sources": [],
              "error": "A native Logic Apps action failed. Inspect the correlated run."
            }
          }
        ]
      }
    },
    "Execute": {
      "type": "Scope",
      "actions": {
        "create_conversation": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://kppfoundry48254cc6.services.ai.azure.com/api/projects/kpp-mining-demo/openai/v1/conversations",
            "headers": {
              "Foundry-Features": "WorkflowAgents=V1Preview"
            },
            "body": {
              "metadata": {
                "demo_id": "48254cc6",
                "run_id": "@outputs('capture_question')?['run_id']",
                "orchestrator": "logic_apps"
              },
              "items": [
                {
                  "type": "message",
                  "role": "user",
                  "content": [
                    {
                      "type": "input_text",
                      "text": "@outputs('capture_question')?['question']"
                    }
                  ]
                }
              ]
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://ai.azure.com"
            },
            "retryPolicy": {
              "type": "none"
            }
          },
          "runAfter": {}
        },
        "classify_question": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://kppfoundry48254cc6.services.ai.azure.com/api/projects/kpp-mining-demo/openai/v1/responses",
            "headers": {
              "Foundry-Features": "WorkflowAgents=V1Preview"
            },
            "body": {
              "input": "@outputs('capture_question')?['question']",
              "stream": false,
              "max_output_tokens": 2048,
              "conversation": "@body('create_conversation')?['id']",
              "agent_reference": {
                "type": "agent_reference",
                "name": "kppdemo-router",
                "version": "1"
              }
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://ai.azure.com"
            },
            "retryPolicy": {
              "type": "none"
            }
          },
          "runAfter": {
            "create_conversation": [
              "Succeeded"
            ]
          }
        },
        "record_router_response": {
          "type": "SetVariable",
          "inputs": {
            "name": "NativeResponses",
            "value": "@body('classify_question')?['id']"
          },
          "runAfter": {
            "classify_question": [
              "Succeeded"
            ]
          }
        },
        "Parse_router": {
          "type": "Scope",
          "runAfter": {
            "record_router_response": [
              "Succeeded"
            ]
          },
          "actions": {
            "require_completed_router": {
              "type": "ParseJson",
              "runAfter": {},
              "inputs": {
                "content": "@body('classify_question')",
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "output"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "completed"
                      ]
                    },
                    "output": {
                      "type": "array"
                    }
                  }
                }
              }
            },
            "router_messages": {
              "type": "Query",
              "runAfter": {
                "require_completed_router": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('require_completed_router')?['output']",
                "where": "@equals(item()?['type'],'message')"
              }
            },
            "router_decision": {
              "type": "ParseJson",
              "runAfter": {
                "router_messages": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "content": "@first(first(body('router_messages'))?['content'])?['text']",
                "schema": {
                  "type": "object",
                  "required": [
                    "route"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "route": {
                      "type": "string",
                      "enum": [
                        "mcp",
                        "rest_api",
                        "knowledge",
                        "foundry_iq",
                        "fabric_data",
                        "fabric_iq",
                        "work_iq",
                        "clarification",
                        "unsupported"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "invalid_router_result": {
          "type": "SetVariable",
          "inputs": {
            "name": "Result",
            "value": {
              "run_id": "@outputs('capture_question')?['run_id']",
              "route": "unsupported",
              "status": "failed",
              "answer": null,
              "sources": [],
              "error": "The router returned an unrecognized route. No specialist was invoked."
            }
          },
          "runAfter": {
            "Parse_router": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "route_question": {
          "type": "Switch",
          "expression": "@body('router_decision')?['route']",
          "cases": {
            "mcp": {
              "case": "mcp",
              "actions": {
                "mark_mcp": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@concat('https://kppfoundry48254cc6.services.ai.azure.com/api/projects/kpp-mining-demo/openai/v1/conversations/',body('create_conversation')?['id'],'/items')",
                    "headers": {
                      "Foundry-Features": "WorkflowAgents=V1Preview"
                    },
                    "body": {
                      "items": [
                        {
                          "type": "message",
                          "role": "assistant",
                          "content": [
                            {
                              "type": "output_text",
                              "text": "KPP_ROUTE:mcp"
                            }
                          ]
                        }
                      ]
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://ai.azure.com"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {}
                },
                "invoke_mcp": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
