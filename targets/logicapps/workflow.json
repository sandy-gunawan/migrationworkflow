                        "type": "agent_reference",
                        "name": "kppdemo-mcp",
                        "version": "1"
                      }
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://ai.azure.com"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {
                    "mark_mcp": [
                      "Succeeded"
                    ]
                  }
                },
                "normalize_mcp": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://kppdemo-maf-48254cc6.azurewebsites.net/api/normalize-result",
                    "headers": {},
                    "body": {
                      "run_id": "@outputs('capture_question')?['run_id']",
