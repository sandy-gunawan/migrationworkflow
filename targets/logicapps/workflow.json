                    ]
                  }
                },
                "record_mcp_response": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "NativeResponses",
                    "value": "@concat(body('classify_question')?['id'],',',body('invoke_mcp')?['id'])"
                  },
                  "runAfter": {
                    "normalize_mcp": [
                      "Succeeded"
                    ]
                  }
                },
                "set_result_mcp": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Result",
                    "value": "@body('normalize_mcp')"
                  },
